# Copie este arquivo para ".env" e preencha com as connection strings do seu
# banco Postgres (ex: Neon -> dashboard do projeto -> "Connection Details").
#
# DATABASE_URL: connection string "pooled" (com "-pooler" no host) — usada
# pela aplicação em produção (serverless-friendly).
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: connection string direta (sem "-pooler") — usada apenas para
# rodar as migrations do Prisma.
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.regiao.aws.neon.tech/neondb?sslmode=require"
